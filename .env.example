# Default demo: no model calls, no credentials.
TRIPLEDGER_PROVIDER=demo
TRIPLEDGER_DATA_DIR=.tripledger
# Live mode sends receipt text and questions to the configured provider.
# Change provider to openai or anthropic. Never commit real keys.
# TRIPLEDGER_MODEL=your-supported-model-id
# TRIPLEDGER_API_KEY=your-api-key
# TRIPLEDGER_TIMEOUT_SECONDS=45
